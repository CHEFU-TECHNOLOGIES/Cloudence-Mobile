{
  "expo": {
    "name": "Cloudence",
    "slug": "cloudence",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/cloudence-favicon.png",
    "scheme": "cloudence",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/cloudence-favicon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#008080",
        "foregroundImage": "./assets/images/cloudence-favicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "za.co.chefu.cloudence",
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#008080",
          "image": "./assets/images/cloudence-favicon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "cloudence-alerts"
        }
      ],
      "expo-sharing",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "./plugins/withOptionalHardware",
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "cloudence-mobile",
          "organization": "chefu-technologies"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0fa2688a-a97e-4acb-85b5-9493f25e8c56"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0fa2688a-a97e-4acb-85b5-9493f25e8c56"
    }
  }
}
